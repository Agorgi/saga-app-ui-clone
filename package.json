{
  "name": "saga-app-ui-clone",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Standalone wireframe clone of the Saga web app UI (app.try-saga.com). UI only — no backend, no real data. For cosmetic iteration and design handoff.",
