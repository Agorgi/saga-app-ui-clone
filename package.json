    "embla-carousel-react": "^8.6.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.1",
    "react-select": "^5.10.2",
    "react-toastify": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "sass": "^1.98.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
